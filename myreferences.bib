@article{hann_integral-based_2005,
	title = {Integral-based parameter identification for long-term dynamic verification of a glucose–insulin system model},
	volume = {77},
	issn = {0169-2607},
	url = {https://www.sciencedirect.com/science/article/pii/S0169260704002123},
	doi = {10.1016/j.cmpb.2004.10.006},
	abstract = {Hyperglycaemia in critically ill patients increases the risk of further complications and mortality. This paper introduces a model capable of capturing the essential glucose and insulin kinetics in patients from retrospective data gathered in an intensive care unit (ICU). The model uses two time-varying patient specific parameters for glucose effectiveness and insulin sensitivity. The model is mathematically reformulated in terms of integrals to enable a novel method for identification of patient specific parameters. The method was tested on long-term blood glucose recordings from 17 ICU patients, producing 4\% average error, which is within the sensor error. One-hour forward predictions of blood glucose data proved acceptable with an error of 2–11\%. All identified parameter values were within reported physiological ranges. The parameter identification method is more accurate and significantly faster computationally than commonly used non-linear, non-convex methods. These results verify the model's ability to capture long-term observed glucose–insulin dynamics in hyperglycemic ICU patients, as well as the fitting method developed. Applications of the model and parameter identification method for automated control of blood glucose and medical decision support are discussed.},
	number = {3},
	urldate = {2026-01-20},
	journal = {Computer Methods and Programs in Biomedicine},
	author = {Hann, Christopher E. and Chase, J. Geoffrey and Lin, Jessica and Lotz, Thomas and Doran, Carmen V. and Shaw, Geoffrey M.},
	month = mar,
	year = {2005},
	keywords = {Critical care, Glucose, Hyperglycemia, Insulin, Integrals, Modeling, Parameter identification},
	pages = {259--270},
	file = {ScienceDirect Full Text PDF:/Users/juni/Zotero/storage/KLBPGUA5/Hann et al. - 2005 - Integral-based parameter identification for long-term dynamic verification of a glucose–insulin syst.pdf:application/pdf;ScienceDirect Snapshot:/Users/juni/Zotero/storage/HFSKZ9MN/S0169260704002123.html:text/html},
}

@article{ghosh_deepbayesestimator_2024,
	title = {{DeepBayes}—{An} estimator for parameter estimation in stochastic nonlinear dynamical models},
	volume = {159},
	issn = {0005-1098},
	url = {https://www.sciencedirect.com/science/article/pii/S0005109823004934},
	doi = {10.1016/j.automatica.2023.111327},
	abstract = {Stochastic nonlinear dynamical systems are ubiquitous in modern, real-world applications. Yet, estimating the unknown parameters of stochastic, nonlinear dynamical models remains a challenging problem. The majority of existing methods employ maximum likelihood or Bayesian estimation. However, these methods suffer from some limitations, most notably the substantial computational time for inference coupled with limited flexibility in application. In this work, we propose DeepBayes estimators that leverage the power of deep recurrent neural networks. The method consists of first training a recurrent neural network to minimize the mean-squared estimation error over a set of synthetically generated data using models drawn from the model set of interest. The a priori trained estimator can then be used directly for inference by evaluating the network with the estimation data. The deep recurrent neural network architectures can be trained offline and ensure significant time savings during inference. We experiment with two popular recurrent neural networks — long short term memory network (LSTM) and gated recurrent unit (GRU). We demonstrate the applicability of our proposed method on different example models and perform detailed comparisons with state-of-the-art approaches. We also provide a study on a real-world nonlinear benchmark problem. The experimental evaluations show that the proposed approach is asymptotically as good as the Bayes estimator.},
	urldate = {2026-01-22},
	journal = {Automatica},
	author = {Ghosh, Anubhab and Abdalmoaty, Mohamed and Chatterjee, Saikat and Hjalmarsson, Håkan},
	month = jan,
	year = {2024},
	keywords = {Deep learning, Dynamical systems, Nonlinear system identification, Parameter estimation, Recurrent neural networks},
	pages = {111327},
	file = {ScienceDirect Full Text PDF:/Users/juni/Zotero/storage/VJF3TM3K/Ghosh et al. - 2024 - DeepBayes—An estimator for parameter estimation in stochastic nonlinear dynamical models.pdf:application/pdf;ScienceDirect Snapshot:/Users/juni/Zotero/storage/TVU69YGC/S0005109823004934.html:text/html},
}
